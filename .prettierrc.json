{
  "plugins": ["@prettier/plugin-xml"],
  "overrides": [
    {
      "files": ["mod/**/*.xml", "mod/**/*.rpm"],
      "options": {
        "parser": "xml",
        "printWidth": 120,
        "tabWidth": 2,
        "useTabs": false,
        "endOfLine": "lf",
        "xmlWhitespaceSensitivity": "ignore",
        "xmlQuoteAttributes": "preserve"
      }
    }
  ]
}
