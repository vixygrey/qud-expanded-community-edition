<?xml version="1.0" encoding="utf-8" ?>
<naming Load="Merge">
  <!-- Load="Merge" sits here once and cascades: LoadNamingNode reads it and every level below
       inherits it via `Reader.GetAttribute("Load") ?? LoadMode`. Do not remove it, and do not
       override it lower down. Without it LoadNameStyleNode removes the namestyle from
       _NameStyleList and never adds the replacement back, so Qudish leaves name generation
       entirely and every procedurally named human is called NameGenFail1, NameGenFail2, ...
       tools/validate_mod.py's naming-merge-discipline check refuses to let that ship. -->
  <namestyles>
    <!-- Measured from the shipped Naming.xml: 29 prefixes, 20 infixes, 24 postfixes, drawn as
         prefix=1, infix=0-2, postfix=1. That is ~93,500 distinct names, so exact repeats are NOT
         what a player notices - about 0.2% across 20 rolls. Repeated *syllables* are: a 50%
         chance of a repeated opening after 6.3 draws. So this widens openings and endings and
         deliberately leaves the infix pool alone.

         No Amount attributes: the loader only assigns Amount when the attribute is non-empty,
         so omitting it keeps vanilla's. A merge states only what it changes.

         Only hard and neutral endings go here. The soft, vowel-final endings live in the two
         namestyles below, because putting them in the shared pool would soften every name in
         the game regardless of gender - which is the thing this deliberately does not do. -->
    <namestyle Name="Qudish">
      <scopes>
        <!-- The player-facing half. mod/Scripting/Vixy_NameFlavourModule.cs replaces the
           random player name at BOOTEVENT_GENERATERANDOMPLAYERNAME, passing the Tag the player
           asked for - which is the only way to reach a character whose name is generated before
           the character exists.

           Priority 200 with Combine="false" because an explicit choice should win outright.
           Vixy_Random is Priority 50 and combines instead: all three namestyles carry it at the
           same priority, so the weighted draw splits evenly between them, which is what "random"
           means here rather than a fourth pool. -->
        <scope Name="Vixy_Masc" Tag="Vixy_Masc" Priority="200" Combine="false" />
        <scope Name="Vixy_Random" Tag="Vixy_Random" Priority="50" Combine="true" />
      </scopes>
      <prefixes>
        <prefix Name="ae" />
        <prefix Name="be" />
        <prefix Name="ce" />
        <prefix Name="dho" />
        <prefix Name="el" />
        <prefix Name="en" />
        <prefix Name="esh" />
