    <!-- An even mix of both ending types, for the genders that are neither.

         One scope per gender, because NameScope.Gender is a single exact-match string rather
         than a list. `elverson` is scoped here even though vanilla hides it behind
         Generic="false" - the scope is simply inert until something makes that gender
         reachable, and inert is the right state for it to be in meanwhile.

         `hartind` is deliberately absent. Its person terms are hartind/faun, which makes it the
         hindren third gender rather than a general one, and hindren have their own namestyle. -->
    <namestyle Name="Vixy_Qudish Neutral" Format="TitleCase">
      <scopes>
        <!-- The player-facing half. mod/Scripting/Vixy_NameFlavourModule.cs replaces the
           random player name at BOOTEVENT_GENERATERANDOMPLAYERNAME, passing the Tag the player
           asked for - which is the only way to reach a character whose name is generated before
           the character exists.

           Priority 200 with Combine="false" because an explicit choice should win outright.
           Vixy_Random is Priority 50 and combines instead: all three namestyles carry it at the
           same priority, so the weighted draw splits evenly between them, which is what "random"
           means here rather than a fourth pool. -->
        <scope Name="Vixy_Neutral" Tag="Vixy_Neutral" Priority="200" Combine="false" />
        <scope Name="Vixy_Random" Tag="Vixy_Random" Priority="50" Combine="true" />
        <scope Name="Vixy_Gender neuterperson" Species="human" Gender="neuterperson" Priority="50" Combine="true" />
        <scope Name="Vixy_Gender nonspecific" Species="human" Gender="nonspecific" Priority="50" Combine="true" />
        <scope Name="Vixy_Gender elverson" Species="human" Gender="elverson" Priority="50" Combine="true" />
      </scopes>
      <prefixes Amount="1">
