      </prefixes>
      <infixes>
        <infix Name="ala" />
        <infix Name="eli" />
        <infix Name="ien" />
        <infix Name="isa" />
        <infix Name="nye" />
        <infix Name="sya" />
        <infix Name="thi" />
        <infix Name="vae" />
      </infixes>
      <postfixes>
        <postfix Name="ek" />
        <postfix Name="eth" />
        <postfix Name="ik" />
