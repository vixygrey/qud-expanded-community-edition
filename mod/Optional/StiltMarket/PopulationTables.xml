      <object Blueprint="Torchpost" Number="1-2" Hint="InsideCorner" />
      <object Blueprint="Raven_SmithySign" Number="1" Hint="OutsideDoor:1" />
      <object Blueprint="Torchpost" Number="1-2" Hint="OutsideDoor:2" />
      <object Blueprint="Table" Number="2-3" Hint="AlongInsideWall" />
      <object Blueprint="Woven Basket" Number="1-2" />
      <object Blueprint="Chest" Number="2-3" Hint="AlongInsideWall" />
      <object Blueprint="Long Sword2" Number="1" Chance="33" />
      <object Blueprint="Desert Kris" Number="1" Chance="33" />
      <object Blueprint="Iron Vinereaper" Number="1" Chance="33" />
      <object Blueprint="Bronze Ingot" Number="1-2" />
