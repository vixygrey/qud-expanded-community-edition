    <group Name="Contents" Style="pickeach">
      <object Blueprint="Raven_Smithy" Number="1" Hint="Interior" />
      <table Name="Raven_SmithyTentContents" />
    </group>
  </population>

  <population Name="Raven_SmithyTentContents">
