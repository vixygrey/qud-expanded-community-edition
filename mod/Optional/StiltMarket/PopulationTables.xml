  <!--
    A legendary smithy draws one tier above the zone, which is vanilla's own idiom for a hero
    merchant. `{zonetier+1}` is substituted before RequireTable sees it, and Tier.Constrain clamps
    the result, so this cannot reach past tier 8 even where the zone could.
  -->
  <population Name="Raven_SmithyInventory_Legendary">
    <group Name="Items" Style="pickeach">
      <table Name="DynamicInheritsTable:BaseCudgel:Tier{zonetier+1}" Number="2" Hint="SetBonusModChance:30" />
      <table Name="DynamicInheritsTable:BaseAxe:Tier{zonetier+1}" Number="2" Hint="SetBonusModChance:30" />
      <table Name="DynamicInheritsTable:BaseDagger:Tier{zonetier+1}" Number="2" Hint="SetBonusModChance:30" />
      <table Name="DynamicInheritsTable:BaseLongBlade:Tier{zonetier+1}" Number="2" Hint="SetBonusModChance:30" />
