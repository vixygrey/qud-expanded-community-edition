      <object Blueprint="Chest" Number="0-1" Hint="AlongInsideWall" />
      <object Blueprint="Raven_Merchant Water Vase" Number="2-3" Hint="AlongOutsideFrontWall" />
      <object Blueprint="Raven_Merchant Water Vase" Number="1-2" Hint="AlongInsideWall" />
      <object Blueprint="Raven_Merchant Water Bottle" Number="2-3" Hint="AlongInsideWall" />
