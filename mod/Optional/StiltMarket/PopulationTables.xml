  <!-- ================================================================== the pedlar, this fork's -->

  <!--
    Deliberately the poorest stock at the Stilt: junk, a little water, and whatever the scrap heap
    gave up. Nothing here is worth crossing the salt for, which is the point - the pedlar exists so
    an empty tent has somebody in it, not so it has treasure in it.
  -->
  <population Name="Vixy_PedlarInventory">
    <group Name="Items" Style="pickeach">
      <table Name="Junk 1" Number="4-7" />
      <object Blueprint="EmptyWaterskin" Number="1-2" />
      <object Blueprint="HalfFullWaterskin" Number="0-1" />
      <object Blueprint="Yuckwheat Stem" Number="2-4" />
      <object Blueprint="Vinewafer" Number="1-3" />
      <table Name="Scrap 1" Number="3-6" />
      <object Blueprint="Torch" Number="1-3" />
      <object Blueprint="Bandage" Number="1-2" />
      <table Name="Injectors" Number="1" Chance="15" />
