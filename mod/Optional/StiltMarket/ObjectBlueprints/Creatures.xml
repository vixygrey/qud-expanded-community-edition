  <!--
    Vixy_Pedlar - this fork's, not Mura's.

    An unclaimed stall in a real bazaar is not empty, it is somebody with not much to sell. Vanilla's
    EmptyTent holds one table and nothing else, and the Grand Bazaar filled it with eight to twelve
    bedrolls; this puts a person there instead, which is the only version that explains why the tent
    was standing.

    Deliberately the poorest merchant at the Stilt. Junk, a little water, whatever the scrap heap gave
    up - the odds and ends nobody else stocks. Role="Skirmisher" rather than Brute or Minion, because
    Role is a x4 lever on the dynamic pools and a pedlar has no business being common there.
  -->
  <object Name="Vixy_Pedlar" Inherits="BaseMerchant">
    <part
      Name="Render"
      DisplayName="pedlar"
      Tile="Creatures/caste_5.bmp"
      ColorString="&amp;w"
      DetailColor="K"
      RenderString="@"
    />
    <part Name="ConversationScript" ConversationID="Vixy_Pedlar" />
    <part Name="GenericInventoryRestocker" Table="Vixy_PedlarInventory" Chance="71" />
    <inventoryobject Blueprint="Sandals" />
    <inventoryobject Blueprint="@Junk 1" Number="2-4" />
    <part
      Name="Description"
      Short="=pronouns.Subjective= =verb:have:afterpronoun= laid out what =pronouns.subjective= =verb:have:afterpronoun=, which is not much, on a square of cloth =pronouns.subjective= =verb:intend:afterpronoun= to fold up and carry off."
    />
    <part Name="AISelfPreservation" Threshold="40" />
    <tag Name="LairAdjectives" Value="threadbare" />
    <tag Name="StaticLikeReason" Value="buying something nobody else wanted" />
    <tag Name="StaticHateReason" Value="turning out their cloth" />
    <tag Name="Role" Value="Skirmisher" />
  </object>
</objects>
