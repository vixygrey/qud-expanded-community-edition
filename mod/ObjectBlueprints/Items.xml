<?xml version="1.0" encoding="utf-8" ?>
<objects>
  <!-- Random colours on mundane made objects, #608. The reasoning, the two rules and the
       descendant audit are all in ObjectBlueprints/Furniture.xml, where the rest of these live.
       Each palette below quotes the description line it was read from. -->

  <!-- "An earthen pot of Svy mud fired in a marsh oven." Unpainted earthenware, so fired reds and
       ochres rather than vanilla's `all` - a clay pot has no reason to come out blue. Vanilla's
       painted pottery (Vase, Pitcher, Ewer, Jug) uses `all` precisely because it is painted. -->
  <object Name="Clay Pot" Load="Merge">
    <part Name="RandomColors" DetailColor="r,R,w,y,W" />
  </object>

  <!-- "Collagen was molded into a liquid vessel." Not a botanical gourd, so no greens.

       MainColor only, and that is the important part: Gourd is one of nine blueprints in the game
       carrying <tag Name="DetailColorByLiquid">, and LiquidVolume rewrites that field from the
       contents on every render. A DetailColor palette here would be silently overwritten by
       whatever it is holding. The liquid owns the detail; the collagen body is ours. -->
  <object Name="Gourd" Load="Merge">
    <part Name="RandomColors" MainColor="w,W,y" />
  </object>

  <!-- "Brinestalk was scythed from its marsh home and dried in the high salt sun." Brinestalk
       green through sun-bleached, staying inside the colour family the fences and gates use. -->
  <object Name="Walking Stick" Load="Merge">
    <part Name="RandomColors" DetailColor="g,G,w,y" />
  </object>

  <!-- "Two almonds of glass sit in wireframe cups." Brass, steel and copper frames.
       PairDetailWithForeground draws both fields at the same index, so the glint always matches
       the frame rather than contradicting it. -->
  <object Name="Spectacles" Load="Merge">
    <part Name="RandomColors" MainColor="y,w,W" DetailColor="Y,y,w" PairDetailWithForeground="true" />
  </object>

  <!-- "Particulate from the eons-sheared shale sticks in the fibers." Dust-greyed wool. -->
  <object Name="Cloth Robe" Load="Merge">
    <part Name="RandomColors" MainColor="y,w,W" DetailColor="y,w,K" />
  </object>

  <!-- "Rough tight-spun yarn balloons at the calf." Homespun, undyed. -->
  <object Name="Cloth Overalls" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W" />
  </object>

  <!-- "The crown is crushed by wear into a hundred papery creases." Straw. -->
  <object Name="Wide-brimmed Hat" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W" />
  </object>

  <!-- "A pair of strapped shoes are cracked on the soles." Leather. -->
  <object Name="Sandals" Load="Merge">
    <part Name="RandomColors" DetailColor="w,y,r" />
  </object>

  <!-- Keeps the four unreachable-mod upgrade recipes off data disks found in the world. #723.

       There is no per-recipe "tinkerable but not findable" attribute: every consumer reads the one
       TinkerData.TinkerRecipes list, and its only gate, TinkerAllowed, removes a recipe from
       tinkering as well. So the exclusion has to happen where a disk picks its recipe.

       The part uses BeforeObjectCreatedEvent and AfterObjectCreatedEvent rather than
       ObjectCreatedEvent, because GameObjectFactory.CreateObject runs the BeforeObjectCreated
       delegate - which is where TinkerData.createDataDisk sets Data - before either. A disk minted
       deliberately therefore already has its recipe, vanilla's own handler is guarded by
       `if (Data == null)`, and a one-event re-roll would destroy exactly the disk a quest or a
       teacher hands over. Straddling vanilla's roll separates the two on ordering the engine
       guarantees rather than on part registration order.

       Loot generation is closed separately and by data, with MinTier="99" in Core/Mods.xml. -->
  <object Name="DataDisk" Load="Merge">
    <part Name="Vixy_UpgradeDiskFilter" />
  </object>

  <!-- Local histories for four named bookshelves, #740. The texts are in Core/Books.xml, which
       carries the register and the per-place reasoning; the population merges are in
       Core/PopulationTables.xml.

       Two attributes below are a pair, and vanilla is consistent about them. Across the 34
       blueprints inheriting Book, every general-pool scholarly text is value 35-350 and carries
       no exclusion tag, while every location-bound or trivial one - HistoryofJoppaVol1 and Vol2,
       Sheaf1, GolemOperatingManual, Sonnet - is priced at or near zero AND declares
       ExcludeFromDynamicEncounters. Both halves matter:

       - Value 0 matches the two Joppa volumes and keeps these out of the Stilt librarian's
         award. LibrarianGiveBook pays value squared over 25 and lists nothing scoring 0, so
         scholarly finds still pay and a place's own history does not.
       - ExcludeFromDynamicEncounters must be declared here rather than inherited. The base Book
         blueprint carries it with *noinherit, which per docs/LESSONS.md means it applies to Book
         alone and does not pass to children. Without it RandomAltarBaetyl, SocialSifrahTokenItem
         and RitualSifrahTokenItem can all demand one of these - a baetyl asking for a book that
         exists in exactly one location, and only sometimes.

       No RevealSecretOnRead. The two Joppa volumes reveal JoppaSecret1 and JoppaSecret2, but the
       journal-secret system is theirs and extending it is a separate decision, not a detail. -->

  <object Name="Vixy_OnTheEnclaveOrchard" Inherits="Book">
    <part
      Name="Render"
      DisplayName="{{W|On the Enclave Orchard}}"
      ColorString="&amp;c"
      TileColor="&amp;c"
      DetailColor="Y"
      Tile="Items/sw_book_1.bmp"
    />
    <part
      Name="Description"
      Short="Lengths of spooled tape were cut into leaves and stitched between two thin plates of fulcrete."
    />
    <part Name="Book" ID="Vixy_OnTheEnclaveOrchard" />
    <part Name="Commerce" Value="0" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>

  <object Name="Vixy_TheRuinedNook" Inherits="Book">
    <part
      Name="Render"
      DisplayName="{{W|The Ruined Nook}}"
      ColorString="&amp;g"
      TileColor="&amp;g"
      DetailColor="M"
      Tile="Items/sw_scroll1.bmp"
    />
    <part Name="Description" Short="Pressed lilypad has been dried flat and sewn along one edge with root fiber." />
    <part Name="Book" ID="Vixy_TheRuinedNook" />
    <part Name="Commerce" Value="0" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>

  <object Name="Vixy_ANoteOnTheSpongebed" Inherits="Book">
    <part
      Name="Render"
      DisplayName="{{W|A Note on the Spongebed}}"
      ColorString="&amp;c"
      TileColor="&amp;c"
      DetailColor="W"
      Tile="Items/sw_book_4.bmp"
    />
    <part Name="Description" Short="Sheets pressed from reef sponge are bound between two shims of palladium." />
    <part Name="Book" ID="Vixy_ANoteOnTheSpongebed" />
    <part Name="Commerce" Value="0" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>

  <object Name="Vixy_AccountsOfTheOutcrop" Inherits="Book">
    <part
      Name="Render"
      DisplayName="{{W|Accounts of the Outcrop}}"
      ColorString="&amp;w"
      TileColor="&amp;r"
      DetailColor="r"
      Tile="Items/sw_unfurled_scroll2.bmp"
    />
    <part
      Name="Description"
      Short="Salt-stiffened pages are stitched into a cover of cracked hide, swollen once by water and dried flat again."
    />
    <part Name="Book" ID="Vixy_AccountsOfTheOutcrop" />
    <part Name="Commerce" Value="0" />
    <tag Name="ExcludeFromDynamicEncounters" Value="*noinherit" />
  </object>
</objects>
