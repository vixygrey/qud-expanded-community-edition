  <!-- Books for the general pool and the booksellers, #741. Texts in Core/Books.xml, table entries
       in Core/PopulationTables.xml.

       These carry a real value and NO ExcludeFromDynamicEncounters, which is the opposite of the
       four local histories above and deliberate. Across vanilla's 34 Book descendants the split is
       clean: a general-pool scholarly text is priced 35-350 and carries no exclusion tag, while a
       location-bound or trivial one is priced at or near zero and declares it. These are the first
       kind. So they pay the Stilt librarian - LibrarianGiveBook awards value squared over 25 - and
       they are eligible for the baetyl and Sifrah pools exactly as vanilla's own texts are, which
       is correct for a scholarly find and wrong for a village's own history.

       Values sit inside vanilla's band rather than above it. Salt Week is 35, matching Corpus as
       the cheapest authored text in the pool, because it is a labourer's week on the back of a
       ledger and pricing it like a treatise would be the joke misfiring. -->

  <object Name="Vixy_FrivolousLivesVol2" Inherits="Book">
    <part
      Name="Render"
      DisplayName="{{W|Frivolous Lives, Vol. II}}"
      ColorString="&amp;g"
      TileColor="&amp;W"
      DetailColor="g"
      Tile="Items/sw_book_2.bmp"
    />
    <part
      Name="Description"
      Short="Pressed leaves are bound between board and a lacquer that has not aged. The margins are annotated in a hand that never presses hard."
    />
    <part Name="Book" ID="Vixy_FrivolousLivesVol2" />
    <part Name="Commerce" Value="200" />
  </object>

