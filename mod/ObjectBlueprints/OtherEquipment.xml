    <part Name="Backpack" WeightWhenWorn="-100" />
    <part Name="Commerce" Value="400" />
    <part
      Name="Description"
      Short="A large toboggan repels above the ground and gently rocks on an ethereal wave. It's encircled by a corona of wafting dust."
    />
    <part Name="Examiner" Alternate="Unknownmetal box" Complexity="4" />
    <part Name="TinkerItem" Bits="00345" CanDisassemble="true" CanBuild="true" />
    <tag Name="Tier" Value="6" />
    <tag Name="Floating" />
  </object>

  <object Name="Raven_CyberneticsCreditPass" Inherits="Item">
    <part Name="Physics" Weight="0" />
    <part
      Name="Render"
      DisplayName="{{C|cybernetics credit pass}}"
      RenderString="-"
      ColorString="&amp;c"
      Occluding="false"
      RenderIfDark="true"
      Tile="Items/sw_wedge3.bmp"
      DetailColor="C"
    />
    <part Name="CyberneticsCreditWedge" Credits="3" />
    <part Name="Commerce" Value="450" />
    <tag Name="NoEquip" Value="1" />
    <part Name="Description" Short="A tiny card of plastic." />
    <tag Name="NoSparkingQuest" />
  </object>

  <!-- Miscellaneous -->

  <object Name="Force Bracelet" Load="Merge">
    <part Name="ForceEmitter" ChargeUse="250" />
  </object>

  <!-- Makes bottles function like phials for things like lava -->
  <object Name="Bottle" Load="Merge">
    <part
      Name="Physics"
      Weight="5"
      Takeable="true"
      Solid="false"
      SpecificHeat="0"
      FreezeTemperature="-9999"
      BrittleTemperature="-9999"
      FlameTemperature="99999"
      VaporTemperature="9999"
    />
    <part Name="Commerce" Value="5" />
    <stat Name="Hitpoints" Value="1000" />
    <stat Name="HeatResistance" Value="100" />
    <stat Name="ColdResistance" Value="100" />
    <stat Name="AcidResistance" Value="100" />
    <stat Name="ElectricResistance" Value="100" />
    <intproperty Name="Inorganic" Value="1" />
    <intproperty Name="ThermalInsulation" Value="1000" />
  </object>

  <object Name="Scrap" Load="Merge">
    <part Name="Physics" Weight="0" />
  </object>

  <!-- For World coordinates, the first two are the X and Y on the big map, however Y goes from top to bottom, and both start at 0. The second two are the X and Y of the 3x3 grid of zones per tile on the big map, going from 0 to 2 for both, and Y starts at the top again. the fifth number is depth, with 10 appearing to be the surface, and 11 is one floor down, 12 is two down, etc etc. -->

  <!-- make all recoilers effectively the same -->
  <object Name="BaseRecoiler" Load="Merge">
    <part Name="Render" DisplayName="{{Y|basic recoiler}}" />
