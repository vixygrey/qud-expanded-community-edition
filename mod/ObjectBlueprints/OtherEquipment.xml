<?xml version="1.0" encoding="utf-8" ?>
<objects>
  <!-- Energy Cells

  Vanilla (Tier in parentheses, Tier functions as a scalar value used for determining a variety of things like drop rates as well as mod capacity and requirements, higher is rarer/better from 1 to 8):

    Mods:
    Radio Powered - Recharges (10 x Tier) per tick, up to (1 + Tier) max depth. Does not stack with Fidget/Solar, the higher recharge rate is used.
    High Capacity - Increases max charge to (Charge x (14 + Tier)) / 10.
    Gigantic - Doubles max charge, stacks with High Capacity (not sure yet if multiplicative or additive).

    Chem Cell (1) - 10000
    Fidget Cell (1) - 2500, recharges 2/20 per tick out of/in combat
    Solar Cell (2) - 2500, recharges 10 per tick in sunlight
    Nuclear Cell (7) - 100000
    Antimatter Cell (8) - 200000
    Liquid Fueled:
      Lead-Acid (4) - 4000 max, 500 per dram
      Combustion (4) - 6000 max, 750 per dram
      Thermoelectric (5) - 40000 max, 5000 per dram
      Biodynamic (6) - 60000, 7500 per dram

  Modded (Tier):

    Advanced Chem Cell (5) - 50000 (5x chem cell, half a nuclear cell)
    Dark Matter (8) - 500000
    Solar Cell Array (4) - 10000, recharges 25 per tick in sunlight (so 4x capacity and 2.5x recharge of basic solar cell)
    Solar Cell Nexus (7) - 50000, recharges 50 per tick in sunlight (so 20x capacity and 5x recharge of basic solar cell, or 5x capacity and 2x recharge of solar cell array)

  -->

  <object Name="Raven_Advanced Chem Cell" Inherits="Energy Cell">
    <part
      Name="Render"
      DisplayName="{{C|advanced}} {{c|chem cell}}"
      ColorString="&amp;c"
      RenderString="'"
      RenderLayer="5"
    />
    <part Name="EnergyCell" Charge="50000" MaxCharge="50000" />
    <part
      Name="Description"
      Short="A metallic block, this is energy cell holds much more power than its smaller counterpart."
    />
    <part Name="Commerce" Value="300" />
    <part Name="TinkerItem" Bits="0014" CanDisassemble="true" CanBuild="true" />
    <tag Name="Tier" Value="5" />
    <tag Name="DynamicObjectsTable:EnergyCells" />
    <tag Name="NoSparkingQuest" />
  </object>

  <object Name="Raven_Dark Matter Cell" Inherits="Energy Cell">
    <part
      Name="Render"
      DisplayName="{{K|dark matter}} {{c|cell}}"
      ColorString="&amp;c"
      RenderString="'"
      RenderLayer="5"
    />
    <part Name="EnergyCell" Charge="500000" MaxCharge="500000" />
    <part Name="Physics" Weight="70" />
    <part
      Name="Description"
      Short="A tightly wound hedron of dark matter containing vast amounts of potential energy."
    />
    <part Name="Commerce" Value="1200" />
    <part Name="TinkerItem" Bits="0047" CanDisassemble="true" CanBuild="true" />
    <tag Name="Tier" Value="8" />
    <tag Name="DynamicObjectsTable:EnergyCells" />
    <tag Name="NoSparkingQuest" />
  </object>

  <object Name="Raven_Solar Cell Array" Inherits="Energy Cell">
    <part
      Name="Render"
      DisplayName="{{W|solar}} {{c|cell array}}"
      ColorString="&amp;W"
      RenderString="'"
      RenderLayer="5"
    />
    <part Name="EnergyCell" Charge="10000" MaxCharge="10000" />
    <part
      Name="Description"
      Short="An array of shimmering silver cubes, these cells will slowly recharge if left in sunlight."
    />
    <part Name="SolarArray" ChargeRate="10" />
    <part Name="IntegralRecharger" />
    <part Name="TinkerItem" Bits="0023" CanDisassemble="true" CanBuild="true" />
    <part Name="Commerce" Value="150" />
    <tag Name="Tier" Value="4" />
    <tag Name="DynamicObjectsTable:EnergyCells" />
    <tag Name="TinkerCategory" Value="ammo and energy cells" />
  </object>

  <object Name="Raven_Solar Cell Nexus" Inherits="Energy Cell">
    <part
      Name="Render"
      DisplayName="{{W|solar}} {{c|cell nexus}}"
      ColorString="&amp;W"
      RenderString="'"
      RenderLayer="5"
    />
    <part Name="EnergyCell" Charge="50000" MaxCharge="50000" />
    <part
      Name="Description"
      Short="An undulating nexus of shimmering silver cubes, they will gradually recharge if left in sunlight."
    />
    <part Name="SolarArray" ChargeRate="10" />
    <part Name="IntegralRecharger" />
    <part Name="TinkerItem" Bits="0025" CanDisassemble="true" CanBuild="true" />
    <part Name="Commerce" Value="225" />
    <tag Name="Tier" Value="7" />
    <tag Name="DynamicObjectsTable:EnergyCells" />
    <tag Name="TinkerCategory" Value="ammo and energy cells" />
    <tag Name="NoSparkingQuest" />
  </object>

  <!-- Floating Nearby -->

  <object Name="Raven_Advanced Hoversled" Inherits="Tool">
