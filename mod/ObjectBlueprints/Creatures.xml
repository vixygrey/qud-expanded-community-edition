<?xml version="1.0" encoding="utf-8" ?>
<objects>
  <!-- Enemy Adjustments -->

  <!-- Chute crab claw can deal 0 damage as well now-->

  <object Name="Chute Crab Claw" Load="Merge">
    <part Name="MeleeWeapon" BaseDamage="1d3-1" Skill="Cudgel" Slot="Hand" />
  </object>

  <!-- Custom Bodies -->

  <object Name="TrueKin" Inherits="Humanoid">
    <part Name="Body" Anatomy="TrueKin" />
  </object>

  <object Name="PsionicAdept" Inherits="Humanoid">
    <part Name="Body" Anatomy="PsionicAdept" />
  </object>

  <!-- Creature variants (#171) - PROOF OF MECHANISM, one variant only.

       A cosmetic colour variant of a common creature. It differs in name, colour and description
       and in nothing else: no <stat>, no part beyond Render.

       The first attempt at this shipped 32 of them and none ever spawned, because they were
       distributed with a DynamicObjectsTable:<Biome>_Creatures tag and **nothing in the game reads
       those tables**. Hills_Creatures is named in exactly one file - the one where creatures
       declare membership - and no population table references it. See docs/LESSONS.md.

       Biome creatures come from ordinary populations, so this one is distributed the way every
       other piece of this fork's content is: an explicit entry in mod/PopulationTables.xml, merged
       into the vanilla table a zone template actually draws from. Both ends verified this time -
       ZoneTemplates.xml's `Hills` zonetemplate reads HillsZoneGlobals-Reachable in its <global>
       block, which is what puts a goat in front of a player.

       It carries no DynamicObjectsTable tag of its own, and tools/dynamic-pools.json still records
       it in Hills_Creatures and Mountains_Creatures: those come from Goat by inheritance. Harmless,
       because nothing consumes them - but recorded rather than papered over with *delete tags,
       which would only be tidying a pool that is never rolled.

       The other 31 stay out until this one is seen in a running game. -->

  <object Name="Vixy_DunGoat" Inherits="Goat">
    <part Name="Render" DisplayName="{{w|dun goat}}" ColorString="&amp;w" TileColor="&amp;w" DetailColor="W" />
    <part
      Name="Description"
      Short="A coat the colour of dry hillside runs from =pronouns.possessive= shoulders to =pronouns.possessive= hocks, so that =pronouns.subjective= =verb:are:afterpronoun= easy to miss until =pronouns.subjective= =verb:move:afterpronoun=."
    />
  </object>
</objects>
