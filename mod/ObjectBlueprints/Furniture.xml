<?xml version="1.0" encoding="utf-8" ?>
<objects>
  <object Name="Raven_Empty Weapon Rack" Inherits="Chest">
    <part Name="Render" DisplayName="weapon rack" Tile="Items/sw_weapons_rack.bmp" ColorString="&amp;c" />
    <part Name="Description" Short="Wooden and chrome poles let weapons rest peacefully." />
    <part Name="Container" Preposition="on" />
    <tag Name="Tier" Value="2" />
    <tag Name="NoSparkingQuest" />
    <tag Name="HangingSupport" />
  </object>

  <object Name="Raven_Empty Gun Rack" Inherits="Raven_Empty Weapon Rack">
    <part Name="Render" DisplayName="gun rack" Tile="Items/sw_weapons_rack.bmp" DetailColor="K" />
    <part Name="Description" Short="Wooden and chrome poles let guns rest peacefully." />
  </object>

  <object Name="Raven_Empty Armor Rack" Inherits="Weapon Rack">
    <part Name="Render" DisplayName="armor rack" Tile="Items/sw_weapons_rack.bmp" DetailColor="Y" />
    <part Name="Description" Short="Wooden and chrome poles let armor rest peacefully." />
  </object>

  <object Name="Raven_Rusted Door" Inherits="Metal Door">
    <part
      Name="Render"
      DisplayName="rusted door"
      ColorString="&amp;r^C"
      TileColor="&amp;r"
      DetailColor="C"
      RenderString="+"
      Occluding="false"
      RenderIfDark="true"
    />
    <part
      Name="Description"
      Short="Sheet metal is locked in diamond pattern and welded into the shape of a door. The surface is scorched and scratched in sections."
    />
  </object>

  <!-- A latched gate swings shut. Vanilla's own descriptions say so - a brinestalk gate is "set
       across an iron-latched rail", an iron gate across a "latched rail" - and nothing in the game
       ever closes anything behind you. Merged onto Gate rather than Door: gates are see-through,
       shoot-through and fly-over, so closing one costs no tactical option, where auto-closing an
       interior door would. Brinestalk Gate and Iron Gate inherit it. See #631. -->
  <object Name="Gate" Load="Merge">
    <part Name="Vixy_SelfClosingGate" />
  </object>

  <!-- Random colours on mundane made objects, #608. RandomColors is vanilla machinery: it reads a
       comma-separated palette off the XML, picks one per instance on ObjectCreatedEvent, and then
       removes itself - so this costs nothing in a save.

       Two rules govern which blueprints get one and what goes in it.

       The colour must carry no information. That rules out every material ladder in this mod -
       bronze through zetachrome is how a player reads a weapon's tier at a glance - and it is why
       vanilla writes <removepart Name="RandomColors" /> fourteen times, on things like Cider Vase
       and Honey Vase where the colour is the liquid. Every descendant of these was checked: the
       Grit Gate bed and chair set ownership only, and Preserved Food Basket sets an inventory
       table, so none of them loses a colour it had chosen.

       The palette comes from the blueprint's own description rather than from taste. Each entry
       below quotes the line it was read from. Naturals stay narrow; only the Chiliad Basket gets
       the full range, because its description is the only one that says "dyed". -->

  <!-- "Planks of wood are nailed together simply to form the austere seat" - and the chair the
       same, at right angles. Pale through dark timber. -->
  <object Name="Bench" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W,r" />
  </object>
  <object Name="Chair" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W,r" />
  </object>
  <object Name="Stool" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W,r" />
  </object>

  <!-- "Fabrics were stuffed with watervine chaff and laid across wooden slats." Fabrics are dyed,
       so this one may carry a colour a bedroll may not. -->
  <object Name="Bed" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W,r,g" />
  </object>

  <!-- "A goat wool bed fastened with canvas ties." Undyed wool and canvas, so naturals only -
       the distinction from the bed above is the whole reason these are two entries. -->
  <object Name="Bedroll" Load="Merge">
    <part Name="RandomColors" DetailColor="y,w,W" />
  </object>

  <!-- "Kneaded under the salt sun by a leatherworker and stuffed with glo[wing moss]." Tanned
       leather. -->
  <object Name="Armchair" Load="Merge">
    <part Name="RandomColors" DetailColor="w,y,r,W" />
  </object>

  <!-- "Marsh reed was handcrossed by warp and weft into a vessel." Undyed reed. Chiliad Basket
       inherits this one and overrides it below, which is why both fields are stated there. -->
  <object Name="Woven Basket" Load="Merge">
    <part Name="RandomColors" MainColor="w" DetailColor="w,y,W" />
  </object>

  <!-- "Dyed rush and palm fronds were pulled to a westwise weave." The only one of these whose
       description says dyed, so the only one that earns the full range. Declared in vanilla's
       HiddenObjects.xml rather than Furniture.xml; merges match on the object name, so it sits
       here beside the basket it inherits from. Both fields are restated because the parent above
       sets MainColor and a child's part merges over it attribute by attribute. -->
  <object Name="Chiliad Basket" Load="Merge">
    <part Name="RandomColors" MainColor="w" DetailColor="all" />
  </object>

  <!-- A band on the march, as one object on the world map. #832.

       Not the party. Brain.GoToPartyLeader refuses world-map targets outright and
       JoinPartyLeaderCommand applies that rule to every cached zone, so a leader lifted onto the map
       leaves its retinue behind. This travels alone and Vixy_Band builds the real party at the
       destination from FactionEncounters' own tables, which is cheaper and sidesteps the rule
       rather than fighting it.

       Inherits Object rather than PhysicalObject, and the omission is the design: Object is
       Physics alone, so this has **no Brain**. IsCombatObject() is (Flags & 2), and vanilla's own
       obsolete overload says combat-flagged objects always have a Brain - so being Brain-less makes
       it non-combat with no flag to set. It cannot be attacked on a map with no tactical terrain,
       and AIWorldMapTravel moves it with Forced: true, which bypasses the mobility check that would
       otherwise fail on a null Brain.

       RenderLayer 2 because every terrain object is 1, and a band standing on a parasang should be
       seen rather than hidden under the ground it is crossing.

       Reachable through mod/Scripting/ naming it (#926) and by no other route, deliberately: it is
       bookkeeping that walks, and a population table entry would put it in the world as scenery. -->
  <object Name="Vixy_Band" Inherits="Object">
    <part
      Name="Render"
      DisplayName="band"
      Tile="Items/sw_banner.bmp"
      RenderString="&#182;"
      ColorString="&amp;y"
      DetailColor="w"
      RenderLayer="2"
      RenderIfDark="true"
    />
    <part Name="Physics" Solid="false" Takeable="false" IsReal="true" Weight="0" />
    <part Name="Description" Short="A company on the move, seen from a long way off." />
    <part Name="Vixy_Band" />
  </object>
</objects>
