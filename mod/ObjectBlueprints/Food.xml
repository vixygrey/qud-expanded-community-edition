  <!-- Harvest yields and their preserved forms (#177).

       Each plant in mod/ObjectBlueprints/Plants.xml yields a Snack, and each Snack preserves into
       an ingredient carrying a cooking effect vanilla already defines. No new effect type is
       introduced: regenLowtier, plantMinor and starch are all in use on vanilla plants today, so
       the cooking system gains ingredients rather than behaviour.

       Prices are anchored to a named vanilla neighbour rather than to the value curve, which does
       not describe food - of vanilla's 32 tiered, priced edibles, none sits on it. The curve
       exempts food for that reason; see docs/STYLEGUIDE.md 3.2. -->

  <!-- Mountains. 4 beside witchwood bark, also 4, also a mountain harvest. -->
  <object Name="Vixy_Cragwort Sprig" Inherits="Snack">
    <part
      Name="Render"
      DisplayName="{{w|cragwort sprig}}"
      Tile="Items/sw_wheat_stem.bmp"
      ColorString="&amp;w"
      DetailColor="W"
      RenderString="'"
      RenderLayer="5"
    />
    <part Name="Commerce" Value="4" />
    <part
      Name="Food"
      Satiation="Snack"
      Thirst="0"
      Healing="0"
      Message="It is bitter, and grit crunches between your teeth."
    />
    <part Name="PreservableItem" Result="Vixy_Dried Cragwort" Number="3" />
    <part Name="Description" Short="Woody and grey-green, cut close to the root where the stem is still soft." />
  </object>

  <object Name="Vixy_Dried Cragwort" Inherits="Preservable">
    <part
      Name="Render"
      DisplayName="dried {{w|cragwort}}"
      Tile="Items/sw_grass_bundle.bmp"
      RenderString="%"
      ColorString="&amp;w"
      DetailColor="W"
      RenderLayer="5"
    />
    <part Name="Commerce" Value="4" />
    <part Name="PreparedCookingIngredient" type="regenLowtier" charges="1" />
    <part Name="Description" Short="Hung in bunches until the bitterness turns to something closer to pepper." />
    <tag Name="Plant" />
    <!--
      A village's signature dish is built from its biome's ingredient pool - VillageBase.cs:2586
      takes 80% of a dish's one to three ingredients from it - and 24 of vanilla's 40 preserved
      cooking ingredients are tagged into one.

      Not all 40, and the split is the reason this is the right pool. Every regional plant preserve
      carries one: Starapple Preserves, Fermented Yondercane, Dried Lah Petals, Vinewafer Sheaf,
      Fermented Yuckwheat Stem. What lacks one is mostly manufactured or placeless - Food Cube,
      Canned Have-It-All, Crusty Loaf, Mirror Dust. These three are the first kind.

      Raw snacks stay out. Starapple, Yondercane and Vinewafer carry no such tag - only what has
      been put up for keeping is a village's stock. See docs/FEATURES.md 18.7.
    -->
    <tag Name="DynamicObjectsTable:Mountains_Ingredients" />
  </object>

