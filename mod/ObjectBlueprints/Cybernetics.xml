      Name="Description"
      Short="The emitted frequencies of your tiniest bits are synchronized with the standardized band for force emission, whilst hidden compartments hold fluted keys for every wavelength along every spectrum permit entrance through every portal."
    />
    <part
      Name="Render"
      DisplayName="&amp;Womni &amp;ypass"
      Tile="Items/sw_comminterlock.bmp"
      ColorString="&amp;K"
      DetailColor="r"
    />
    <part
      Name="CyberneticsBaseItem"
      Slots="Hands,Feet,Body,Back,Face,Arm,Head"
      Cost="2"
      BehaviorDescription="You can walk through forcefields and unlock any door."
    />
    <part Name="CyberneticsPropertyModifier" Props="DoorUnlocker:1" />
    <part Name="CyberneticsForcefieldNullifier" />
    <tag Name="StartingCybernetic:General" />
  </object>

