# Store text files with LF line endings.
* text=auto eol=lf

# Keep Git metadata and repository guidance as text.
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.md text eol=lf
*.markdown text eol=lf

# Mark common binary files as non-text.
*.7z binary
*.avi binary
*.bmp binary
*.class binary
*.dll binary
*.eot binary
*.gif binary
*.ico binary
*.jar binary
*.jpeg binary
*.jpg binary
*.mov binary
*.mp3 binary
*.mp4 binary
*.otf binary
*.pdf binary
*.png binary
*.so binary
*.tar binary
*.ttf binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
*.xls binary
*.xlsx binary
*.zip binary
